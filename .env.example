# Copy to .env and fill in. Never commit .env.

# Alpaca PAPER trading keys (https://app.alpaca.markets/paper/dashboard/overview)
#
# Can be left blank if you've run `alpaca profile login` (the official Alpaca
# CLI, which authenticates over OAuth in the browser and stores a profile in
# ~/.config/alpaca/profiles/). Credentials resolve in this order, as an atomic
# bundle -- a key from one source is never paired with a secret from another:
#   1. ALPACA_API_KEY + ALPACA_SECRET_KEY (both required)
#   2. the profile's OAuth access_token
#   3. the profile's stored api_key + secret_key
#
# A profile that targets LIVE trading (live_trade: true) is REFUSED, not used.
# This system is paper-only and will not borrow live credentials. Override the
# profile it reads with ALPACA_PROFILE, or its directory with ALPACA_CONFIG_DIR.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Random string shared between the orchestrator and the execution engine.
# Only needed when EXECUTION_MODE=webhook -- direct mode never reads it.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SHARED_SECRET=

# How signals reach the execution engine.
#   direct  (default) - the engine runs in the same process. No webhook, no
#                       port to expose, and WEBHOOK_SHARED_SECRET is not used
#                       at all. This is what makes a scheduled job (GitHub
#                       Actions, cron) a viable host.
#   webhook           - POST to a separately running FastAPI app. Use this to
#                       keep the engine on a different machine from the LLM
#                       side; then the orchestrator holds no broker keys.
EXECUTION_MODE=direct

# Only read when EXECUTION_MODE=webhook.
WEBHOOK_URL=http://localhost:8000/webhook/signal

# Comma-separated tickers evaluated each cycle. Leave blank to use the curated
# list in config/watchlist.py -- 30 names spread across US sectors, Europe and
# Israel (via US-listed ADRs and issuers), emerging markets, and commodity
# producers. It is in code rather than here so a change to what gets traded
# shows up in a diff.
#
# Cost scales with length: roughly $6-7 per ticker per month on Claude, plus
# one Bright Data request per ticker per cycle. Trim the list to spend less.
WATCHLIST=

# Bright Data (https://brightdata.com) — used by the orchestrator to pull recent
# news for each ticker. Create a "SERP API" zone in the dashboard and put its
# name below; the token comes from Account settings -> API tokens.
#
# Can be left blank if you've run `brightdata login` (the official Bright Data
# CLI, which authenticates over OAuth and stores a key locally). The token is
# resolved in this order: BRIGHTDATA_API_TOKEN, then BRIGHTDATA_API_KEY (the
# variable the CLI itself reads), then the CLI's stored login.
#
# The zone resolves as BRIGHTDATA_SERP_ZONE, then BRIGHTDATA_UNLOCKER_ZONE.
# `brightdata login` creates a cli_unlocker zone rather than a SERP API zone --
# that is fine. Bright Data's own CLI sends searches through an unlocker zone
# by preference, so after the login you can simply set:
#     BRIGHTDATA_UNLOCKER_ZONE=cli_unlocker
# and leave BRIGHTDATA_SERP_ZONE alone. No dashboard visit needed. If your
# account refuses search on an unlocker zone (the symptom is a NewsFetchError
# about HTML instead of JSON), create a SERP API zone and name it below.
BRIGHTDATA_API_TOKEN=
#
# Leave BOTH blank if you ran `brightdata login`: the zone then defaults to
# cli_unlocker, which that login creates. Set BRIGHTDATA_SERP_ZONE only if you
# actually created a SERP API zone in the dashboard -- it no longer defaults to
# a name, because a non-empty default made the unlocker fallback unreachable.
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# Claude API key (https://console.anthropic.com) — the orchestrator asks Claude
# to turn each ticker's context into a signal. Nothing else in the system
# talks to an LLM.
#
# Can be left blank if you've run `ant auth login` (the Anthropic CLI) on
# the machine that runs the heartbeat: the SDK falls back to that profile,
# to ANTHROPIC_AUTH_TOKEN, or to Workload Identity Federation, in that
# order. Best suited to local runs under your own login; an unattended
# deployment should still use an explicit key here.
ANTHROPIC_API_KEY=

# --- Remote archive (optional) -------------------------------------------- #
#
# Where the signal journal and execution audit are copied after each cycle, so
# the record stops having to live in git forever. Leave BOTH blank and nothing
# changes: the push step prints "no remote archive configured" and exits 0.
#
# Create the tables once before the first push:
#     python store/push_remote.py --print-schema    # then run it in the SQL editor
#
# SUPABASE_URL is the project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
#
# The SERVICE-ROLE key, not the publishable/anon one. It has to be the service
# key because the tables run with row-level security enabled and no policies --
# which is deliberate: it means a leaked publishable key can do nothing at all,
# not even read. The service key bypasses RLS, so it is the whole archive's
# write access in one string. Put it in a GitHub Actions secret, never in code
# and never in a browser.
SUPABASE_SERVICE_KEY=

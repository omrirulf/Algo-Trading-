# Copy to .env and fill in. Never commit .env.

# Alpaca PAPER trading keys (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Random string shared between the orchestrator and the execution engine.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SHARED_SECRET=

# Where the orchestrator POSTs signals
WEBHOOK_URL=http://localhost:8000/webhook/signal

# Comma-separated tickers the orchestrator asks the LLM about each cycle
WATCHLIST=AAPL,MSFT,NVDA

# Bright Data (https://brightdata.com) — used by the orchestrator to pull recent
# news for each ticker. Create a "SERP API" zone in the dashboard and put its
# name below; the token comes from Account settings -> API tokens.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api

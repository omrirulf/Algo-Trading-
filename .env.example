# Copy to .env and fill in. Never commit .env.

# Alpaca PAPER trading keys (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Random string shared between the orchestrator and the execution engine.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SHARED_SECRET=

# Where the orchestrator POSTs signals
WEBHOOK_URL=http://localhost:8000/webhook/signal

# Comma-separated tickers the orchestrator asks the LLM about each cycle
WATCHLIST=AAPL,MSFT,NVDA

# Bright Data (https://brightdata.com) — used by the orchestrator to pull recent
# news for each ticker. Create a "SERP API" zone in the dashboard and put its
# name below; the token comes from Account settings -> API tokens.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api

# Claude API key (https://console.anthropic.com) — the orchestrator asks Claude
# to turn each ticker's context into a signal. Nothing else in the system
# talks to an LLM.
#
# Can be left blank if you've run `ant auth login` (the Anthropic CLI) on
# the machine that runs the heartbeat: the SDK falls back to that profile,
# to ANTHROPIC_AUTH_TOKEN, or to Workload Identity Federation, in that
# order. Best suited to local runs under your own login; an unattended
# deployment should still use an explicit key here.
ANTHROPIC_API_KEY=
